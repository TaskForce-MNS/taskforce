FROM mcr.microsoft.com/dotnet/sdk:10.0

ARG USER_UID=1000
ARG USER_GID=1000

# ✅ -o autorise les UID/GID dupliqués — fonctionne toujours, sans branchement fragile
RUN groupadd -o -g ${USER_GID} dotnetgroup \
    && useradd -o -u ${USER_UID} -g dotnetgroup -m -d /home/dotnetuser -s /bin/bash dotnetuser

WORKDIR /app
RUN mkdir -p bin obj && chown -R dotnetuser:dotnetgroup /app

USER dotnetuser
ENV HOME=/home/dotnetuser

RUN dotnet tool install --global dotnet-ef
ENV PATH="$PATH:/home/dotnetuser/.dotnet/tools"

ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true
ENV DOTNET_SKIP_FIRST_TIME_EXPERIENCE=true

COPY --chown=dotnetuser:dotnetgroup Api.Back.csproj .
RUN dotnet restore

COPY --chown=dotnetuser:dotnetgroup . .

EXPOSE 8080

ENTRYPOINT ["dotnet", "watch", "run", "--no-launch-profile", "--urls", "http://0.0.0.0:8080"]