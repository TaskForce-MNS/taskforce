---
import Layout from "../layouts/Layout.astro";
import TaskforceLogo from "../components/TaskforceLogo.astro";
import ProjectWorkspacePreview from "../components/ProjectWorkspacePreview.astro";

const features = [
	{
		number: "01",
		title: "Un espace par projet",
		description:
			"Retrouvez le contexte, les tâches et les personnes au même endroit. Chaque projet garde son identité et reste simple à suivre.",
		icon: "grid",
	},
	{
		number: "02",
		title: "Des tâches qui avancent",
		description:
			"Découpez le travail, posez une échéance et attribuez chaque tâche à la bonne personne. L’avancement reste visible pour toute l’équipe.",
		icon: "check",
	},
	{
		number: "03",
		title: "Les bonnes personnes, ensemble",
		description:
			"Invitez vos collaborateurs, gérez les rôles et partagez les compétences utiles pour mieux répartir le travail.",
		icon: "people",
	},
];

const steps = [
	{
		number: "01",
		title: "Créez un projet",
		description:
			"Donnez un nom à votre espace et réunissez le contexte utile.",
	},
	{
		number: "02",
		title: "Invitez l’équipe",
		description: "Ajoutez vos collaborateurs et définissez leur rôle.",
	},
	{
		number: "03",
		title: "Faites avancer le travail",
		description:
			"Créez les tâches, répartissez-les et suivez la progression.",
	},
];
---

<Layout>
	<div class="site-shell">
		<header class="site-header">
			<a class="brand" href="#accueil" aria-label="Taskforce, accueil"
				><TaskforceLogo gradientId="header-mark" /></a
			>
			<nav class="main-nav" aria-label="Navigation principale">
				<a href="#fonctionnalites">Fonctionnalités</a><a
					href="#comment-ca-marche">Comment ça marche</a
				>
			</nav>
			<a
				class="header-cta"
				href="https://app.staging.taskforce.stagiairesmns.fr/auth"
				>Ouvrir Taskforce <span aria-hidden="true">↗</span></a
			>
		</header>

		<main>
			<section class="hero" id="accueil">
				<div class="hero-copy">
					<p class="eyebrow">
						<span class="eyebrow-dot"></span> Le travail d’équipe, sans
						dispersion
					</p>
					<h1>
						Les projets avancent mieux <span
							>quand tout le monde est aligné.</span
						>
					</h1>
					<p class="hero-description">
						Taskforce rassemble vos projets, vos tâches et votre
						équipe dans un espace clair. Moins de choses à chercher,
						plus de travail qui avance.
					</p>
					<div class="hero-actions">
						<a
							class="button button-primary"
							href="https://app.staging.taskforce.stagiairesmns.fr/auth"
							>Découvrir l’application <span aria-hidden="true"
								>↗</span
							></a
						><a class="text-link" href="#fonctionnalites"
							>Explorer les fonctionnalités <span
								aria-hidden="true">↓</span
							></a
						>
					</div>
					<div class="hero-note">
						<span class="note-line"></span> Un espace partagé, pensé pour
						le quotidien des équipes.
					</div>
				</div>
				<div
					class="hero-visual"
					aria-label="Aperçu de l’espace projet Taskforce"
				>
					<div class="visual-orbit orbit-one"></div><div
						class="visual-orbit orbit-two"
					>
					</div><ProjectWorkspacePreview /><div class="floating-note">
						<span class="floating-check">✓</span><span
							><strong>Bien réparti</strong><small
								>Les tâches sont attribuées</small
							></span
						>
					</div><div class="floating-label">
						<span></span> Projet d’équipe
					</div>
				</div>
			</section>

			<section class="signal-bar" aria-label="Taskforce en bref">
				<p>
					Tout ce qu’il faut pour <strong
						>faire avancer un projet ensemble.</strong
					>
				</p><div class="signal-items">
					<span><i class="signal-mark mark-project"></i>Projets</span
					><span><i class="signal-mark mark-tasks"></i>Tâches</span
					><span><i class="signal-mark mark-team"></i>Équipe</span>
				</div>
			</section>

			<section class="features-section section-wrap" id="fonctionnalites">
				<div class="section-heading">
					<p class="eyebrow">
						<span class="eyebrow-dot"></span> Un espace qui rassemble
					</p><h2>
						Le bon travail.<br /><span>Au bon endroit.</span>
					</h2><p class="section-intro">
						Tout le monde sait où en est le projet, ce qu’il reste à
						faire et qui s’en occupe.
					</p>
				</div>
				<div class="feature-list">
					{
						features.map((feature) => (
							<article class="feature-row">
								<span class="feature-number">
									{feature.number}
								</span>
								<div class="feature-icon" aria-hidden="true">
									{feature.icon === "grid" && (
										<svg viewBox="0 0 24 24" fill="none">
											<rect
												x="3.5"
												y="3.5"
												width="7"
												height="7"
												rx="1.5"
											/>
											<rect
												x="13.5"
												y="3.5"
												width="7"
												height="7"
												rx="1.5"
											/>
											<rect
												x="3.5"
												y="13.5"
												width="7"
												height="7"
												rx="1.5"
											/>
											<rect
												x="13.5"
												y="13.5"
												width="7"
												height="7"
												rx="1.5"
											/>
										</svg>
									)}
									{feature.icon === "check" && (
										<svg viewBox="0 0 24 24" fill="none">
											<path
												d="M8 5h11M8 12h11M8 19h11M3.5 5h.01M3.5 12h.01M3.5 19h.01"
												stroke-linecap="round"
												stroke-width="2.3"
											/>
										</svg>
									)}
									{feature.icon === "people" && (
										<svg viewBox="0 0 24 24" fill="none">
											<path
												d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20M9.5 10.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM17 4a3.5 3.5 0 0 1 0 6.8M21 20v-1.5a4 4 0 0 0-3-3.87"
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="1.8"
											/>
										</svg>
									)}
								</div>
								<>
									<div class="feature-copy">
										<>
											<h3>{feature.title}</h3>
											<p>{feature.description}</p>
										</>
									</div>
									<span
										class="feature-arrow"
										aria-hidden="true"
									>
										↗
									</span>
								</>
							</article>
						))
					}
				</div>
			</section>

			<section class="workflow-section" id="comment-ca-marche">
				<div class="workflow-inner">
					<div class="workflow-heading">
						<p class="eyebrow eyebrow-light">
							<span class="eyebrow-dot"></span> Simple dès le premier
							jour
						</p><h2>De l’idée<br />à l’action.</h2><p>
							Un cadre léger pour transformer le travail à faire
							en progrès visibles.
						</p>
					</div>
					<div class="workflow-steps">
						{
							steps.map((step) => (
								<article class="workflow-step">
									<>
										<span class="step-number">
											{step.number}
										</span>
										<div>
											<>
												<h3>{step.title}</h3>
												<p>{step.description}</p>
											</>
										</div>
										<span
											class="step-arrow"
											aria-hidden="true"
										>
											↗
										</span>
									</>
								</article>
							))
						}
					</div>
					<div class="workflow-stamp" aria-hidden="true">
						<span>FAIT<br />ENSEMBLE</span><i>✳</i>
					</div>
				</div>
			</section>

			<section class="closing-cta">
				<div class="closing-mark">
					<TaskforceLogo compact gradientId="closing-mark" />
				</div><p class="eyebrow">
					<span class="eyebrow-dot"></span> Votre équipe peut commencer
					ici
				</p><h2>
					Un projet clair.<br /><span>Une équipe qui avance.</span>
				</h2><a
					class="button button-primary"
					href="https://app.staging.taskforce.stagiairesmns.fr/auth"
					>Ouvrir Taskforce <span aria-hidden="true">↗</span></a
				>
			</section>
		</main>

		<footer class="site-footer">
			<a
				class="brand footer-brand"
				href="#accueil"
				aria-label="Taskforce, retour en haut"
				><TaskforceLogo gradientId="footer-mark" /></a
			><p>Le travail d’équipe, au même endroit.</p><a
				class="footer-top"
				href="#accueil"
				>Retour en haut <span aria-hidden="true">↑</span></a
			><span class="copyright"
				>© {new Date().getFullYear()} Taskforce</span
			>
		</footer>
	</div>
</Layout>

<style>
	:root {
		--ink: #f0f8ff;
		--muted: #acacac;
		--paper: #242424;
		--green: #587b7f;
		--lime: #bfedef;
		--rule: rgba(172, 172, 172, 0.18);
		--display: "Montserrat", sans-serif;
	}
	.site-shell {
		overflow: hidden;
	}
	.site-header {
		height: 80px;
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 38px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid rgba(23, 35, 33, 0.09);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
		text-decoration: none;
		font: 800 20px var(--display);
		letter-spacing: 0;
	}
	.brand-period {
		color: var(--green);
	}
	.brand-mark {
		width: 25px;
		height: 25px;
		display: flex;
		align-items: end;
		gap: 3px;
		padding: 3px;
		border-radius: 7px;
		background: var(--green);
	}
	.brand-mark span {
		display: block;
		width: 5px;
		border-radius: 3px;
		background: var(--lime);
	}
	.brand-mark span:nth-child(1) {
		height: 9px;
		opacity: 0.75;
	}
	.brand-mark span:nth-child(2) {
		height: 15px;
	}
	.brand-mark span:nth-child(3) {
		height: 11px;
		opacity: 0.85;
	}
	.main-nav {
		display: flex;
		align-items: center;
		gap: 36px;
		margin-left: 65px;
	}
	.main-nav a,
	.header-cta {
		color: #45534e;
		text-decoration: none;
		font-size: 13px;
		font-weight: 600;
		transition: color 0.2s ease;
	}
	.main-nav a:hover,
	.footer-top:hover {
		color: var(--green);
	}
	.header-cta {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding: 11px 15px;
		color: white;
		border-radius: 5px;
		background: var(--ink);
	}
	.header-cta:hover {
		background: var(--green);
	}
	.hero {
		max-width: 1240px;
		min-height: 630px;
		padding: 74px 38px 72px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 0.95fr 1.05fr;
		align-items: center;
		gap: 40px;
	}
	.hero-copy {
		position: relative;
		z-index: 2;
		padding-bottom: 5px;
		animation: rise-in 0.7s both;
	}
	.eyebrow {
		display: flex;
		align-items: center;
		gap: 9px;
		margin: 0;
		color: #65736d;
		font-size: 11px;
		line-height: 1.4;
		font-weight: 700;
		letter-spacing: 1.2px;
		text-transform: uppercase;
	}
	.eyebrow-dot {
		width: 7px;
		height: 7px;
		flex: 0 0 7px;
		border-radius: 50%;
		background: #53a880;
		box-shadow: 0 0 0 3px rgba(83, 168, 128, 0.13);
	}
	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}
	h1,
	h2 {
		font-family: var(--display);
		letter-spacing: 0;
	}
	h1 {
		max-width: 600px;
		margin: 27px 0 20px;
		color: var(--ink);
		font-size: clamp(43px, 5.2vw, 68px);
		line-height: 1.09;
		font-weight: 700;
	}
	h1 span,
	.section-heading h2 span,
	.closing-cta h2 span {
		color: var(--green);
	}
	.hero-description {
		max-width: 440px;
		margin-bottom: 28px;
		color: #596861;
		font-size: 16px;
		line-height: 1.75;
	}
	.hero-actions {
		display: flex;
		align-items: center;
		gap: 24px;
		flex-wrap: wrap;
	}
	.button {
		display: inline-flex;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		gap: 18px;
		padding: 0 17px;
		border-radius: 5px;
		text-decoration: none;
		font-size: 13px;
		font-weight: 700;
		transition:
			background 0.2s,
			transform 0.2s;
	}
	.button:hover {
		transform: translateY(-2px);
	}
	.button-primary {
		color: white;
		background: var(--green);
	}
	.button-primary:hover {
		background: #1b604d;
	}
	.text-link {
		color: #33433d;
		text-decoration: none;
		font-size: 12px;
		font-weight: 700;
	}
	.text-link span {
		margin-left: 5px;
		color: var(--green);
	}
	.hero-note {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 43px;
		color: #75817b;
		font-size: 11px;
	}
	.note-line {
		width: 26px;
		height: 1px;
		background: #aab5ae;
	}
	.hero-visual {
		position: relative;
		min-width: 0;
		min-height: 465px;
		display: grid;
		place-items: center;
		isolation: isolate;
		animation: rise-in 0.8s 0.12s both;
	}
	.hero-visual::before {
		position: absolute;
		z-index: -2;
		top: 13%;
		right: 2%;
		width: 85%;
		height: 75%;
		border-radius: 50%;
		background: radial-gradient(
			ellipse,
			#e7eddb 0%,
			#eff1e9 56%,
			transparent 72%
		);
		content: "";
	}
	.visual-orbit {
		position: absolute;
		z-index: -1;
		border: 1px solid rgba(36, 119, 97, 0.12);
		border-radius: 50%;
		transform: rotate(-28deg);
	}
	.orbit-one {
		width: 520px;
		height: 265px;
	}
	.orbit-two {
		width: 565px;
		height: 310px;
	}
	.floating-note {
		position: absolute;
		z-index: 4;
		right: -2%;
		bottom: 8%;
		display: flex;
		align-items: center;
		gap: 11px;
		padding: 13px 17px;
		border: 1px solid rgba(23, 35, 33, 0.08);
		border-radius: 7px;
		background: #fffefa;
		box-shadow: 0 14px 34px rgba(35, 54, 46, 0.1);
		animation: float-in 5s ease-in-out infinite;
	}
	.floating-check {
		width: 29px;
		height: 29px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		color: #256a51;
		background: #e0f2cc;
		font-weight: 700;
	}
	.floating-note strong,
	.floating-note small {
		display: block;
	}
	.floating-note strong {
		margin-bottom: 3px;
		color: #24342e;
		font-size: 11px;
	}
	.floating-note small {
		color: #7c8982;
		font-size: 9px;
	}
	.floating-label {
		position: absolute;
		z-index: 3;
		top: 8%;
		left: 1%;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 9px 12px;
		border: 1px solid #e1e7de;
		border-radius: 4px;
		color: #50615a;
		background: rgba(255, 255, 255, 0.8);
		font-size: 10px;
		font-weight: 600;
	}
	.floating-label span {
		width: 7px;
		height: 7px;
		border-radius: 2px;
		background: #dc9d4c;
	}
	.signal-bar {
		display: flex;
		min-height: 85px;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 18px max(38px, calc((100vw - 1164px) / 2));
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		background: #f0f2ed;
	}
	.signal-bar p {
		margin: 0;
		color: #66736d;
		font-size: 13px;
	}
	.signal-bar strong {
		color: #283a33;
		font-weight: 700;
	}
	.signal-items {
		display: flex;
		align-items: center;
		gap: 34px;
	}
	.signal-items span {
		display: flex;
		align-items: center;
		gap: 9px;
		color: #45544d;
		font-size: 12px;
		font-weight: 600;
	}
	.signal-mark {
		width: 20px;
		height: 20px;
		position: relative;
		display: inline-block;
		border-radius: 5px;
		background: #dce9d9;
	}
	.signal-mark::after {
		position: absolute;
		inset: 5px;
		border: 1.5px solid #39846b;
		border-radius: 2px;
		content: "";
	}
	.mark-tasks {
		background: #f4e7d2;
	}
	.mark-tasks::after {
		border-color: #bd8350;
		border-left: 0;
		border-right: 0;
	}
	.mark-team {
		background: #e5e3ed;
	}
	.mark-team::after {
		border-color: #777a9c;
		border-radius: 50%;
	}
	.section-wrap {
		max-width: 1240px;
		margin: 0 auto;
		padding: 118px 38px 125px;
	}
	.features-section {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 80px;
	}
	.section-heading {
		position: sticky;
		top: 40px;
		align-self: start;
	}
	.section-heading h2 {
		margin: 23px 0 17px;
		color: var(--ink);
		font-size: 48px;
		line-height: 1.14;
		font-weight: 700;
	}
	.section-intro {
		max-width: 330px;
		color: #66736d;
		font-size: 14px;
		line-height: 1.8;
	}
	.feature-list {
		border-top: 1px solid var(--rule);
	}
	.feature-row {
		display: grid;
		grid-template-columns: 34px 48px 1fr 24px;
		align-items: start;
		gap: 17px;
		padding: 27px 0 29px;
		border-bottom: 1px solid var(--rule);
	}
	.feature-number {
		padding-top: 4px;
		color: #8b9890;
		font: 600 10px var(--display);
	}
	.feature-icon {
		width: 43px;
		height: 43px;
		display: grid;
		place-items: center;
		border-radius: 7px;
		color: var(--green);
		background: #e5ede2;
	}
	.feature-row:nth-child(2) .feature-icon {
		color: #af7543;
		background: #f4eadb;
	}
	.feature-row:nth-child(3) .feature-icon {
		color: #6d7495;
		background: #e9e8f0;
	}
	.feature-icon svg {
		width: 20px;
		height: 20px;
		stroke: currentColor;
	}
	.feature-copy h3 {
		margin: 1px 0 8px;
		color: #20312a;
		font: 700 17px var(--display);
	}
	.feature-copy p {
		max-width: 410px;
		margin: 0;
		color: #6b7871;
		font-size: 12px;
		line-height: 1.75;
	}
	.feature-arrow {
		justify-self: end;
		padding-top: 2px;
		color: #789084;
		font-size: 14px;
	}
	.workflow-section {
		position: relative;
		overflow: hidden;
		color: #f5f6f0;
		background: #1d332d;
	}
	.workflow-section::before {
		position: absolute;
		top: -250px;
		right: -90px;
		width: 600px;
		height: 600px;
		border: 1px solid rgba(215, 243, 106, 0.13);
		border-radius: 50%;
		box-shadow:
			0 0 0 48px rgba(215, 243, 106, 0.025),
			0 0 0 96px rgba(215, 243, 106, 0.025);
		content: "";
	}
	.workflow-inner {
		position: relative;
		max-width: 1240px;
		min-height: 445px;
		margin: 0 auto;
		padding: 94px 38px 92px;
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 85px;
	}
	.eyebrow-light {
		color: #bac8c0;
	}
	.eyebrow-light .eyebrow-dot {
		background: var(--lime);
