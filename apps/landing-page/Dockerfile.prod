# ==========================================
# ÉTAPE 1 : BUILD (Sécurisé pour le CI/CD)
# ==========================================
FROM node:22-alpine3.21 AS builder
WORKDIR /app

# On patch le système de build au cas où le scanner de CI vérifie les builders
RUN apk update && apk upgrade --no-cache && corepack enable pnpm

COPY package.json pnpm-lock.yaml ./
RUN pnpm install

COPY . .
RUN pnpm run build

# ==========================================
# ÉTAPE 2 : SERVEUR (Chainguard Nginx — 0 CVE)
# ==========================================
FROM cgr.dev/chainguard/nginx:latest

# Chainguard utilise souvent l'UID 65532 (ou le nom nginx). On sécurise la copie :
COPY --from=builder --chown=nginx:nginx /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]