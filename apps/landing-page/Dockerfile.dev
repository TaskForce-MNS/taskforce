FROM cgr.dev/chainguard/node:latest-dev

WORKDIR /app

# 👇 1. On passe root temporairement pour installer pnpm dans le système
USER root
RUN corepack enable pnpm

# 👇 2. On revient IMMÉDIATEMENT sur l'utilisateur sécurisé de Chainguard (souvent 'node' ou l'UID 65532)
USER node 

# 3. La suite de ton code est parfaite :
COPY --chown=node:node package.json pnpm-lock.yaml ./
RUN pnpm install

COPY --chown=node:node . .

EXPOSE 4321

CMD ["pnpm", "run", "dev", "--host", "0.0.0.0"]