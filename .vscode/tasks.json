{
    "version": "2.0.0",
    "tasks": [
        {
    "label": "build",
    "command": "dotnet",
    "type": "process",
    "args": [
        "build",
        "${workspaceFolder}/apps/Api.Back/Api.Back.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
    ],
    "problemMatcher": "$msCompile"
},
        {
            "label": "EF: Add Migration",
            "type": "shell",
            "command": "dotnet ef migrations add ${input:migrationName} --project apps/Api.Back/",
            "problemMatcher": "$msCompile",
            "group": "none"
        },
        {
            "label": "EF: Update Database",
            "type": "shell",
            "command": "dotnet ef database update --project apps/Api.Back/",
            "problemMatcher": "$msCompile",
            "group": "none"
        },
        {
            "label": "dev",
            "type": "shell",
            "command": "pnpm dev",
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ],
    "inputs": [
        {
            "id": "migrationName",
            "type": "promptString",
            "description": "Nom de la migration (ex: InitialCreate)",
            "default": "NewMigration"
        }
    ]
}