{
  "sonarlint.connectedMode.project": {
    "connectionId": "taskforce-local",
    "projectKey": "taskforce-monorepo"
  },
  "sonarlint.analyzerProperties": {
    "sonar.exclusions": "**/node_modules/**, **/dist/**, **/bin/**, **/obj/**, **/.astro/**"
  },
  "sonarlint.rules": {
    "typescript:S1117": "on", // Exemple : interdit de déclarer deux fois la même variable
    "csharpsquid:S1172": "on" // Exemple : alerte sur les paramètres inutilisés en C#
  },
  "dotnet-test-explorer.testProjectPath": "**/*Tests.csproj",
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
  },
  "makefile.configureOnOpen": false,
  "postman.settings.dotenv-detection-notification-visibility": false
}