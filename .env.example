# 📁 Fichier : .env.example (Racine du projet)

# ------------------------------------------------------------------------------
# BASE DE DONNÉES (Docker & API)
# ------------------------------------------------------------------------------
# Identifiants pour le conteneur PostgreSQL et la chaîne de connexion EF Core
DB_USER=admin
DB_PASSWORD=ton_mot_de_passe_ici
DB_NAME=taskforce_db
DB_PORT=5432
DB_HOST=localhost

# ------------------------------------------------------------------------------
# BACKEND (API C#)
# ------------------------------------------------------------------------------
# Configuration du serveur Kestrel et de l'environnement .NET
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# FRONTEND (React / Vite)
# ------------------------------------------------------------------------------
# URL que le frontend utilisera pour contacter l'API C#
VITE_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# SERVICES IA (Python)
# ------------------------------------------------------------------------------
# Configuration future pour tes services Python
PYTHON_ENV=development
AI_SERVICE_PORT=8000